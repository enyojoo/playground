# Easner API keys from your Business dashboard (server only — never expose in the browser)
EASNER_SECRET_KEY=easner_sk_test_...
# Webhook signing secret — endpoint: /api/webhooks/easner
EASNER_WEBHOOK_SECRET=whsec_...

# Public publishable key (browser — inline and overlay checkout only)
NEXT_PUBLIC_EASNER_PUBLISHABLE_KEY=easner_pk_test_...

# Public URL of this site (used for success_url / cancel_url)
# Production: https://playground.easner.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
