# Easner API keys from your Business dashboard (server only — never expose in the browser)
EASNER_SECRET_KEY=easner_sk_test_...
# Webhook signing secret — endpoint: /api/webhooks/easner
EASNER_WEBHOOK_SECRET=whsec_...

# Publishable key (inline and overlay checkout — safe to expose to the browser)
# Prefer EASNER_PUBLISHABLE_KEY on Vercel so you don't need a rebuild when you add it.
EASNER_PUBLISHABLE_KEY=easner_pk_test_...
# Optional: also set for local tooling; requires redeploy on Vercel if you only use this one.
NEXT_PUBLIC_EASNER_PUBLISHABLE_KEY=easner_pk_test_...

# Public URL of this site (used for success_url / cancel_url and Connect redirect_uri)
# Production: https://playground.easner.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Connect API base (optional). Test secret key only — never a live key in this playground.
# The key needs payees.read, payees.write, payees.credit, and payouts.write.
EASNER_API_BASE=https://api.easner.com

# Signs the PKCE and payee cookies. Use a long random string. Server only.
PLAYGROUND_STATE_SECRET=
